# Copy to .env in the project root (or set as environment variables / Windows service variables).
UCF_ENVIRONMENT=production
# PostgreSQL connection (create the database and a dedicated user first)
UCF_DATABASE_URL=postgresql+psycopg://ucfin_app:CHANGE_ME@localhost:5432/ucfin
# 32+ random characters - e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
UCF_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Session length in minutes
UCF_ACCESS_TOKEN_MINUTES=480
# Password hashing work factor (PBKDF2-SHA256 iterations)
UCF_PASSWORD_ITERATIONS=390000
UCF_MAX_FAILED_LOGINS=5
UCF_LOCKOUT_MINUTES=15
UCF_MIN_PASSWORD_LENGTH=10
UCF_LOGIN_IP_MAX_FAILURES=20
# Where uploaded supporting documents are stored (back this folder up with the database)
UCF_ATTACHMENT_DIR=/var/lib/ucfin/attachments
UCF_MAX_UPLOAD_MB=20
# Only needed if the API is called from another origin (comma separated)
UCF_CORS_ORIGINS=
# Interactive API documentation at /api/docs
UCF_ENABLE_API_DOCS=true
# Initial administrator password used by scripts.seed (remove after first run)
UCF_ADMIN_PASSWORD=
